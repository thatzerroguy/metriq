{
  "name": "metriq",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "dev:api": "bun --filter=@metriq/api run dev",
    "dev:web": "bun --filter=web run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",
    "db:generate": "bun --filter=@metriq/database run db:generate",
    "db:migrate": "bun --filter=@metriq/database run db:migrate",
    "db:push": "bun --filter=@metriq/database run db:push",
    "db:studio": "bun --filter=@metriq/database run db:studio"
  },
  "devDependencies": {
    "prettier": "3.9.6",
    "turbo": "^2.11.9",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=24"
  },
  "devEngines": {
    "packageManager": {
      "name": "bun",
      "version": "1.4.2"
    }
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "dependencies": {}
}
