# ==============================================================================
# Metriq Environment Configuration
# Copy this file to .env for local Docker Compose overrides
# ==============================================================================

# Node / Environment
NODE_ENV=development

# API Service
API_PORT=3001
PORT=3001
BASE_URL=http://localhost:3001

# Web Service
WEB_PORT=3000
SERVER_URL=http://localhost:3001
VITE_APP_TITLE=Metriq

# Database (PostgreSQL)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=metriq
DB_PORT=5432
# Note: DATABASE_URL protocol must be 'postgres://' for schema validation
DATABASE_URL=postgres://postgres:postgres@db:5432/metriq

# Redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379

# Better Auth Configuration
BETTER_AUTH_SECRET=development-better-auth-secret-key-1234567890
BETTER_AUTH_API_KEY=development-better-auth-api-key-1234567890

# External Service Integrations
RESEND_API_KEY=dummy_resend_api_key
